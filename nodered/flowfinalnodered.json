    {
        "id": "5dd3dce69a2250cb",
        "type": "function",
        "z": "8d8b3733db1dce51",
        "name": "Format Data for Sheets",
        "func": "// Fungsi untuk pad angka (contoh: 5 -> \"05\")\nfunction pad(n) {\n    return n < 10 ? '0' + n : n;\n}\n\n// Dapatkan waktu sekarang di WIB (UTC+7)\nlet now = new Date();\nlet wibOffset = 7 * 60 * 60 * 1000; // Offset WIB (7 jam dalam ms)\nlet wibTime = new Date(now.getTime() + wibOffset);\n\n// Format timestamp: \"YYYY-MM-DD HH:mm:ss WIB\"\nlet year = wibTime.getUTCFullYear();\nlet month = pad(wibTime.getUTCMonth() + 1);\nlet day = pad(wibTime.getUTCDate());\nlet hours = pad(wibTime.getUTCHours());\nlet minutes = pad(wibTime.getUTCMinutes());\nlet seconds = pad(wibTime.getUTCSeconds());\n\nlet formattedTime = `${year}-${month}-${day} ${hours}:${minutes}:${seconds} WIB`;\n\n// Data sensor\nlet temp = flow.get('last_temp') || \"N/A\";\nlet humi = flow.get('last_humi') || \"N/A\";\nlet tempds = flow.get('last_tempds') || \"N/A\";\nlet soil = flow.get('last_soil') || \"N/A\";\nlet rain = flow.get('rain_status') || \"N/A\";\nlet pump = flow.get('pump_status') || \"N/A\";\n\nmsg.payload = [[formattedTime, temp, humi, tempds, soil, rain, pump]];\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 620,
        "wires": [
            [
                "c8a2043381583781"
            ]
        ]
    },

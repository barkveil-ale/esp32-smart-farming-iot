    {
        "id": "3817605d1e375c84",
        "type": "function",
        "z": "8d8b3733db1dce51",
        "name": "Auto Pump Logic",
        "func": "let manual = flow.get(\"manualPump\") === true;\nlet rain = flow.get(\"rain_status\");  // \"Hujan\" atau \"Cerah\"\nlet soil = parseInt(flow.get(\"last_soil\"));\n\nif (manual) {\n    flow.set('pump_status', 'OFF');  // Force matikan pompa\n    msg.payload = 'OFF';\n    return msg;\n}\n\nlet status = \"OFF\";\nif (rain === \"Cerah\" && soil < 65) {\n    status = \"ON\";\n} else if (soil > 75 || rain === \"Hujan\") {\n    status = \"OFF\";\n}\n\nflow.set('pump_status', status);\nmsg.payload = status;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 120,
        "wires": [
            [
                "11d57e9f4ec00920"
            ]
        ]
